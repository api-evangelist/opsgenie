{
  "opencollection": "1.0.0",
  "info": {
    "name": "OpsGenie Account API",
    "version": "2.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "Authorization",
      "value": "{{Authorization}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Account",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get account info",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.opsgenie.com/v2/account"
          },
          "docs": "Retrieves account-level information including the account name, plan details, and user count."
        }
      ]
    }
  ],
  "bundled": true
}