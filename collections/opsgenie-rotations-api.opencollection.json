                "description": "Identifier of the schedule, which can be the schedule ID or name."
              },
              {
                "name": "identifierType",
                "value": "",
                "type": "query",
                "description": "Type of the identifier. Possible values are id or name."
              }
            ]
          },
          "docs": "Lists the rotations within the specified schedule."
        },
        {
