    "_postman_id": "cbca6716-cd20-45f4-999c-fc54a4ed944d",
    "name": "OpsGenie Escalation API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The OpsGenie Escalation API allows developers to manage escalation policies that define how alerts are routed when initial responders do not acknowledge them. It provides endpoints for creating, updating, retrieving, and deleting escalation configurations. Escalation rules define the sequence of notifications sent to teams, users, and schedules with configurable delay intervals to ensure incidents are addressed in a timely manner.\n\nContact Support:\n Name: Atlassian Support",
      "type": "text/plain"
    }
  }
