    "_postman_id": "ef296799-de0f-4ea9-9787-7b4a50294160",
    "name": "OpsGenie Service API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The OpsGenie Service API enables developers to manage services within the OpsGenie platform. Services represent business-critical applications and components that can be associated with incidents to track their impact. The API provides endpoints for creating, updating, retrieving, and deleting services. The Service API is available to Standard and Enterprise plan users and is used in conjunction with the Incident API to identify which services are affected during an outage.\n\nContact Support:\n Name: Atlassian Support",
      "type": "text/plain"
    }
  }
