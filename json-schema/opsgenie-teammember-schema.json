{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/TeamMember",
  "title": "TeamMember",
  "type": "object",
  "required": [
    "user",
    "role"
  ],
  "properties": {
    "user": {
      "type": "object",
      "description": "User reference.",
      "properties": {
        "id": {
          "type": "string",
          "description": "User ID."
        },
        "username": {
          "type": "string",
          "description": "Username (email) of the user."
        }
      }
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "description": "Role of the member within the team."
    }
  }
}