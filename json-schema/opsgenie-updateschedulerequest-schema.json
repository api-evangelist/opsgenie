    },
    "ownerTeam": {
      "type": "object",
      "description": "Updated owner team.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Team ID."
        },
        "name": {
          "type": "string",
          "description": "Team name."
        }
      }
    }
